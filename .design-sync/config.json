  "dtsPropsFor": {
    "Seg": "/** Current value; one of the option keys. */\n  value: string;\n  /** [value, label] pairs, rendered left to right. */\n  options: [string, string][];\n  onChange: (v: string) => void;\n  /** Accessible group label (not shown). */\n  label: string;",
    "ThemeTile": "/** An occasion theme, e.g. themeById('diwali') or an entry of THEMES. */\n  theme: { id: string; name: string; bg1: string; bg2: string; ink: string; accent: string; hf: string; qf: string; heads: string[]; quotes: string[] };\n  /** Pass getState().ui.fontTick so the tile redraws once web fonts load. */\n  fontTick: number;",
    "LayoutThumb": "/** Layout id, e.g. 'full', 'arch', 'collage4', 'frame-single', 'cal-top' (see LAYOUTS). */\n  layout: string;\n  /** The design to preview: getState().design or productDesign('postcard'). */\n  design: Record<string, unknown>;\n  /** Photos to fill the slots: getState().photos or samplePhoto(n) items. */\n  photos: unknown[];\n  fontTick: number;",
    "PhotoThumb": "/** A loaded photo: an item of getState().photos, or samplePhoto(n). */\n  photo: { id: string; name: string; src: CanvasImageSource; sw: number; sh: number };",
    "PaneIcon": "/** Which studio step to draw. */\n  id: 'photos' | 'layout' | 'occasion' | 'words' | 'back' | 'print';",
    "ProductIcon": "/** Which product to draw: envelope, calendar or frame. */\n  id: 'postcard' | 'calendar' | 'frame';"
  },
