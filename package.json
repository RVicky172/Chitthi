{
  "name": "chitthi-postcard-studio",
  "productName": "Chitthi",
  "private": true,
  "version": "2.3.0",
  "description": "Design postcards and Instax-style prints for Indian festivals, birthdays and seasons, then download print-ready files.",
  "license": "MIT",
  "author": {
    "name": "RVicky172",
    "email": "rohillavicky172@gmail.com"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview --port 8080",
    "build:lib": "tsc -p tsconfig.lib.json",
    "fetch:samples": "node scripts/fetch-samples.mjs",
    "fetch:fonts": "node scripts/fetch-fonts.mjs",
    "fetch:showcase": "node scripts/fetch-showcase.mjs",
    "build:showcase": "node scripts/build-showcase.mjs",
    "build:quote-docs": "node scripts/build-showcase.mjs --quote",
    "docs:specs": "node scripts/spec-tables.mjs",
    "build:favicons": "node scripts/build-favicons.mjs",
    "desktop:dev": "node electron/dev.mjs",
    "desktop:start": "npm run build && node electron/dev.mjs --prod",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder --publish never",
    "desktop:release": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.48.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "~5.9.3",
    "vite": "^8.3.1"
  },
  "types": "dist-lib/types/index.d.ts"
}
